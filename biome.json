{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!.tmp",
      "!.cache",
      "!public/assets/3d",
      "!public/casts",
      "!public/record",
      "!public/vendor/ask-the-record",
      "!public/vendor/radio",
      "!public/vendor/stamps",
      "!public/vendor/transformers/transformers.min.js",
      "!src/timeline/placeholder.json",
      "!shots"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off"
      },
      "preset": "recommended"
    }
  }
}
